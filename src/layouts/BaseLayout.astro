---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { getLocale, locales, useTranslations } from "../i18n/utils";

import "../styles/global.css";

interface Props {
    title?: string;
    /** Keeps utility pages (like the form's "sent" page) out of search results. */
    noindex?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const title = Astro.props.title ?? t("site.title");

// Strip the locale prefix so alternates point to the same page in each language.
const pathWithoutLocale = Astro.url.pathname.replace(/^\/[^/]+\/?/, "");
// Search engines want absolute hreflang URLs, which need `site` in astro.config.
// Until the production domain is set, emit root-relative URLs instead of baking
// the build-time origin (localhost) into the static HTML.
// Browser UI color (mobile toolbar). Mirrors --color-bg in src/styles/global.css.
const themeColor = { light: "#eee8dc", dark: "#12150f" };

const toHref = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
---

<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        {(["light", "dark"] as const).map((scheme) => (
            <meta
                name="theme-color"
                media={`(prefers-color-scheme: ${scheme})`}
                content={themeColor[scheme]}
                data-light={themeColor.light}
                data-dark={themeColor.dark}
            />
        ))}
        {/* Applies a stored theme choice before first paint, so there's no flash of the
            OS theme; with no choice stored, the CSS already follows the OS on its own. */}
        <script is:inline>
            try {
                const theme = localStorage.getItem("theme");
                if (theme === "light" || theme === "dark") {
                    document.documentElement.dataset.theme = theme;
                    // Both media variants get the chosen color, so the toolbar matches
                    // even when the stored choice differs from the OS.
                    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
                        meta.content = meta.dataset[theme];
                    });
                }
            } catch {}
        </script>
        {/* Same 16px pixel portrait in both: the SVG stays crisp at any size, the .ico is
            the fallback for browsers without SVG favicons. */}
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        {/* Lets the browser paint the canvas and native controls in the right scheme before CSS loads. */}
        <meta name="color-scheme" content="light dark" />
        <Font cssVariable="--font-fira-code" preload />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={t("site.description")} />
        {Astro.props.noindex && <meta name="robots" content="noindex" />}
        <title>{title}</title>
        {locales.map((lang) => (
            <link
                rel="alternate"
                hreflang={lang}
                href={toHref(getRelativeLocaleUrl(lang, pathWithoutLocale))}
            />
        ))}
        {/* The root URL picks a language per visitor, which is what x-default means. */}
        <link rel="alternate" hreflang="x-default" href={toHref("/")} />
    </head>
    <body>
        <Header />
        <main id="main">
            <slot />
        </main>
        <Footer />
    </body>
</html>
