---
import type { GetStaticPaths } from "astro";

import Experience from "../../components/sections/experience/Experience.astro";
import Hero from "../../components/sections/hero/Hero.astro";
import Stack from "../../components/sections/stack/Stack.astro";
import { locales } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

// One file renders every locale; each is prerendered as a static page (/en/, /es/).
export const getStaticPaths = (() =>
    locales.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;
---

<BaseLayout>
    <Hero />
    <Stack />
    <Experience />
</BaseLayout>
