---
interface Props {
    area: string;
    strong: string[];
    familiar: string[];
    /** Tier names, read out before each list so the tier doesn't rely on font weight alone. */
    labels: { strong: string; familiar: string };
}

const { area, strong, familiar, labels } = Astro.props;

const tiers = [
    { label: labels.strong, items: strong, class: "font-semibold text-ink" },
    { label: labels.familiar, items: familiar, class: "text-ink-muted" },
].filter((tier) => tier.items.length > 0);
---

{/* A dl row: dt and dd are the only children allowed besides the wrapping div. */}
<div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 border-b border-rule py-4">
    <dt class="flex shrink-0 items-baseline gap-4">
        <span class="w-37.5 text-label text-ink-muted">{area}</span>
        <span
            aria-hidden="true"
            class="hidden w-15 self-center border-b border-dotted border-rule-strong lg:block"
        ></span>
    </dt>
    <dd class="flex min-w-60 flex-1 flex-wrap gap-x-5.5 gap-y-1.5">
        {tiers.map((tier) => (
            <>
                <span class="sr-only">{tier.label}:</span>
                {/* role="list": Safari drops list semantics once list-style is removed. */}
                <ul role="list" class:list={["flex flex-wrap gap-x-5.5 gap-y-1.5", tier.class]}>
                    {tier.items.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
            </>
        ))}
    </dd>
</div>
