---
import Cursor from "../../ui/Cursor.astro";
import Highlight from "../../ui/Highlight.astro";

interface Props {
    greeting: string;
    name: string;
    class?: string;
}

const { greeting, name, class: className } = Astro.props;
---

<h1 class:list={["text-display lg:text-display-xl", className]}>
    {greeting} <Highlight>{name}</Highlight>.<Cursor />
</h1>
