---
import type { Band } from "../../../data/experience";
import Tag from "../../ui/Tag.astro";

interface Props {
    org: string;
    role: string;
    items: string[];
    band: Band;
    /** Short "how deep" label, like "−1 y". Visual only: the dates already say it. */
    depth: string;
    start: { label: string; datetime: string };
    end: { label: string; datetime: string };
    /** Optional tag next to the org, e.g. "freelance". */
    tag?: string;
    class?: string;
}

const { org, role, items, band, depth, start, end, tag, class: className } = Astro.props;

// Literal class names so Tailwind picks them up. Tokens switch with the theme, and each
// layer gets its own angle so neighbouring bands read apart without relying on color.
const bands: Record<Band, string> = {
    moss: "bg-[repeating-linear-gradient(45deg,var(--color-moss)_0_2px,transparent_2px_6px)]",
    ochre: "bg-[repeating-linear-gradient(-45deg,var(--color-ochre)_0_2px,transparent_2px_6px)]",
    oxide: "bg-oxide",
};
---

<li
    class:list={[
        "grid grid-cols-[0.75rem_minmax(0,1fr)] gap-x-4 lg:grid-cols-[3.25rem_2.25rem_minmax(0,1fr)] lg:gap-x-6",
        className,
    ]}
>
    <span aria-hidden="true" class="hidden pt-4 text-right text-micro text-ink-faint lg:block">
        {depth}
    </span>
    {/* Stretches to the row's height, so the bands stack into one continuous column. */}
    <span aria-hidden="true" class:list={["border border-b-0 border-ink", bands[band]]}></span>
    <div class="border-t border-rule pt-3.5 pb-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="flex flex-wrap items-center gap-3 text-heading">
                {org}
                {tag && <Tag>{tag}</Tag>}
            </h3>
            <p class="text-label font-normal text-oxide">
                <span aria-hidden="true" class="text-ink-faint lg:hidden">
                    {depth} ·{" "}
                </span>
                <time datetime={start.datetime}>{start.label}</time>
                {" — "}
                <time datetime={end.datetime}>{end.label}</time>
            </p>
        </div>
        <p class="mt-1 mb-3 text-body-sm text-ink-muted">{role}</p>
        <ul role="list" class="max-w-[68ch] space-y-1 text-body-sm text-ink-muted">
            {items.map((item) => (
                <li class="flex gap-2">
                    <span aria-hidden="true" class="text-moss">
                        →
                    </span>
                    <span>{item}</span>
                </li>
            ))}
        </ul>
    </div>
</li>
