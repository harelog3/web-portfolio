---
import Tag from "../../ui/Tag.astro";

interface Props {
    /** Small label in the depth column, like "bedrock". */
    label: string;
    degree: string;
    org: string;
    orgFull: string;
    start: string;
    end: string;
    status: string;
    expected: string;
    class?: string;
}

const { label, degree, org, orgFull, start, end, status, expected, class: className } = Astro.props;
---

{/* Education is still in progress and runs under every job, so it's drawn as the base the
    strata rest on (hatched clay, closed by a solid rule) rather than as the oldest layer. */}
<div
    class:list={[
        "grid grid-cols-[0.75rem_minmax(0,1fr)] gap-x-4 lg:grid-cols-[3.25rem_2.25rem_minmax(0,1fr)] lg:gap-x-6",
        className,
    ]}
>
    <span aria-hidden="true" class="hidden pt-4 text-right text-micro text-ink-faint lg:block">
        {label}
    </span>
    <span
        aria-hidden="true"
        class="border border-ink bg-bg-sunken bg-[repeating-linear-gradient(0deg,var(--color-clay)_0_2px,transparent_2px_5px)]"
    ></span>
    <div class="border-t border-b border-t-rule border-b-ink bg-bg-sunken px-4 pt-3.5 pb-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="flex flex-wrap items-center gap-3 text-subheading">
                {degree}
                <Tag>{status}</Tag>
            </h3>
            <p class="text-label font-normal text-oxide">
                <time datetime={start}>{start}</time>
                {" — "}
                <time datetime={end}>{end}</time>
                <span class="text-ink-muted"> {expected}</span>
            </p>
        </div>
        <p class="mt-1 text-body-sm text-ink-muted">
            {org}
            {/* The full name is long; phones keep just the acronym. */}
            <span class="hidden sm:inline">
                {" · "}
                {orgFull}
            </span>
        </p>
    </div>
</div>
