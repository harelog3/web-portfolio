---
import { getRelativeLocaleUrl } from "astro:i18n";

import { getLocale, useTranslations } from "../../i18n/utils";
import Button from "../ui/Button.astro";

interface Props {
    class?: string;
}

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

{/* The projects live in a section of the home page; a page of their own can wait until
    there are enough of them to need one. */}
<Button
    variant="ghost"
    href={`${getRelativeLocaleUrl(locale, "")}#projects`}
    class={Astro.props.class}
>
    {t("actions.projects")}
    <span aria-hidden="true">→</span>
</Button>
