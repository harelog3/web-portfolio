---
import type { HTMLAttributes } from "astro/types";

type Props = {
    id: string;
    label: string;
    class?: string;
} & (
    | ({ as?: "input" } & Omit<HTMLAttributes<"input">, "id" | "class">)
    | ({ as: "textarea" } & Omit<HTMLAttributes<"textarea">, "id" | "class">)
);

const { id, label, as = "input", class: className, ...rest } = Astro.props;

// `user-invalid` only flags a field after the person has interacted with it, so an empty
// form doesn't load already in an error state. The browser's own message names the problem,
// so the border color is never the only signal.
const control =
    "w-full rounded-1 border border-rule-strong bg-bg px-3 text-body-sm text-ink transition-colors hover:border-ink user-invalid:border-oxide";
---

<div class:list={["flex flex-col gap-1.5", className]}>
    <label for={id} class="text-label text-ink-muted">
        {label}
    </label>
    {as === "textarea" ? (
        <textarea
            id={id}
            class:list={[control, "resize-y py-3"]}
            {...(rest as HTMLAttributes<"textarea">)}
        />
    ) : (
        <input id={id} class:list={[control, "h-11"]} {...(rest as HTMLAttributes<"input">)} />
    )}
</div>
