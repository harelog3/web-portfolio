---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span">;

const { class: className, ...rest } = Astro.props;
---

<span
    class:list={[
        "inline-block rounded-1 bg-clay px-2 py-1 text-label font-normal text-ink",
        className,
    ]}
    {...rest}
>
    <slot />
</span>
